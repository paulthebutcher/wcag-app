{
  "name": "wcag-workspace", "version": "0.1.0", "private": true, "type": "module",
  "workspaces": ["apps/*", "packages/*"],
  "engines": {"node": ">=22"},
  "scripts": {
    "dev": "concurrently -k -n api,web 'npm run dev -w @wcag/server' 'npm run dev -w @wcag/web'",
    "build": "npm run typecheck && npm run build -w @wcag/web",
    "typecheck": "tsc --noEmit -p apps/server/tsconfig.json && tsc --noEmit -p apps/web/tsconfig.json",
    "test": "vitest run", "test:watch": "vitest", "test:e2e": "playwright test"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "^1.1.15", "@radix-ui/react-select": "^2.2.6", "@radix-ui/react-slot": "^1.2.3", "@radix-ui/react-tabs": "^1.1.13", "@radix-ui/react-tooltip": "^1.2.8",
    "better-sqlite3": "^12.4.1", "class-variance-authority": "^0.7.1", "clsx": "^2.1.1", "fastify": "^5.6.1", "lucide-react": "^0.468.0", "react": "^19.2.0", "react-dom": "^19.2.0", "react-router-dom": "^7.9.5", "tailwind-merge": "^3.3.1", "zod": "3.25.76"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.11.0", "@playwright/test": "^1.56.1", "@tailwindcss/vite": "^4.1.17", "@types/better-sqlite3": "^7.6.13", "@types/node": "^24.10.0", "@types/react": "^19.2.2", "@types/react-dom": "^19.2.2", "@vitejs/plugin-react": "^5.1.0", "concurrently": "^9.2.1", "tailwindcss": "^4.1.17", "tsx": "^4.20.6", "typescript": "^5.9.3", "vite": "^7.2.2", "vitest": "^3.2.4"
  }
}
